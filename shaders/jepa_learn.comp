// jepa_learn.comp — Update prediction weights from errors
// Each invocation updates weights for one room.

#version 450

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Rooms {
    float rooms[];
};

layout(std430, binding = 1) readonly buffer Predictions {
    float predictions[];
};

layout(std430, binding = 2) readonly buffer WeightOffsets {
    uint weight_offsets[];
};

layout(std430, binding = 3) readonly buffer WeightCounts {
    uint weight_counts[];
};

layout(std430, binding = 4) readonly buffer WeightIndices {
    uint weight_indices[];
};

layout(std430, binding = 5) buffer WeightValues {
    float weight_values[];
};

layout(push_constant) uniform PushConstants {
    uint n_rooms;
    float learning_rate;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= n_rooms) return;

    float error = rooms[idx] - predictions[idx];

    uint offset = weight_offsets[idx];
    uint count = weight_counts[idx];

    for (uint w = 0; w < count; w++) {
        uint j = weight_indices[offset + w];
        float grad = error * rooms[j];
        float new_weight = weight_values[offset + w] + learning_rate * grad;
        weight_values[offset + w] = max(new_weight, 0.0);
    }
}
